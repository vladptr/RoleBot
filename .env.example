DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here

# Если указать ID сервера, слэш-команды появятся сразу (удобно для теста).
# Для нескольких серверов оставь пустым — команды зарегистрируются глобально.
GUILD_ID=

# Папка для JSON с привязкой пользователь → роль.
# На Render укажи путь диска, например /data
DATA_DIR=./data

# Render подставляет PORT сам. Локально по умолчанию 8080.
PORT=8080
